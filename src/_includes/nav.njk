<nav>
  <div class="logo">
    <div class="logo-dot"></div>
    <span class="logo-bracket">[</span>{{ site.name }}<span class="logo-bracket">]</span>
  </div>
  <ul class="nav-links">
    {% for link in site.navLinks %}
      <li><a href="{{ link.url }}" class="{% if page.url == link.url %}active{% endif %}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
  <div class="nav-right">
    <button class="btn-primary">Subscribe</button>
  </div>
</nav>
