<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  
  <!-- CSS -->
  <link rel="stylesheet" href="{{ '/assets/base.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/home.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/home.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/post.css' | url }}">

  <!-- SEO Meta Tags -->
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} | {{ site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
</head>
<body>

  {% include "nav.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

</body>
</html>
